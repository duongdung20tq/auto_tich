var _otpCountdownTimer = null;

function startOtpCountdown() {
  clearInterval(_otpCountdownTimer);
  var secondsEl = document.getElementById('verify-otp-seconds');
  var prevWindow = Math.floor(Date.now() / 1000 / 30);

  function tick() {
    var now = Math.floor(Date.now() / 1000);
    var remaining = 30 - (now % 30);
    if (secondsEl) secondsEl.textContent = remaining;

    var currentWindow = Math.floor(now / 30);
    if (currentWindow !== prevWindow) {
      prevWindow = currentWindow;
      $('#verify-2fa-card .otp-cell').val('');
      document.querySelector('#verify-2fa-card .otp-cell').focus();
    }
  }

  tick();
  _otpCountdownTimer = setInterval(tick, 1000);
}

var _resetOtpCountdownTimer = null;

function startResetOtpCountdown(totalSeconds) {
  clearInterval(_resetOtpCountdownTimer);
  var secondsEl = document.getElementById('reset-2fa-otp-seconds');
  var countdownEl = document.getElementById('reset-2fa-otp-countdown');
  var remaining = totalSeconds;

  function tick() {
    if (secondsEl) secondsEl.textContent = remaining;
    if (remaining <= 0) {
      clearInterval(_resetOtpCountdownTimer);
      if (countdownEl) countdownEl.textContent = 'Mã OTP đã hết hạn, vui lòng thử lại';
      return;
    }
    remaining--;
  }

  tick();
  _resetOtpCountdownTimer = setInterval(tick, 1000);
}

bitechLogin.setup = function (elContainer, oOptions) {

  async function login(uc, password) {
    return await fetchJson('/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8' },
      body: JSON.stringify({
        uc: uc !== undefined ? uc : document.getElementById('idUser').value,
        password: password !== undefined ? password : document.getElementById('idPassword').value
      })
    });
  }

  async function verifyAccount(username, password) {
    return await fetchJson('/auth/reset-2fa/verify-account', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8' },
      body: JSON.stringify({ username: username, password: password })
    });
  }

  async function verifyOTP(resetToken, otp) {
    return await fetchJson('/auth/reset-2fa/verify-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8' },
      body: JSON.stringify({ resetToken: resetToken, otpCode: otp })
    });
  }

  async function resendOTP(resetToken) {
    return await fetchJson('/auth/reset-2fa/resend-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8' },
      body: JSON.stringify({ resetToken: resetToken })
    });
  }

  async function enableReset2FA(resetToken, code) {
    return await fetchJson('/auth/reset-2fa/enable', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8' },
      body: JSON.stringify({ resetToken: resetToken, code: code })
    });
  }

  async function setup2FA(uc) {
    return await fetchJson('/auth/setup-2fa', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8', 'Accept': 'application/json' },
      body: JSON.stringify({ uc: uc, password: document.getElementById('idPassword').value })
    });
  }

  async function changePassword(userName, oldPwd, newPwd) {
    return await fetchJson('/auth/change-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8', 'Accept': 'application/json' },
      body: JSON.stringify({ username: userName, oldPassword: oldPwd, newPassword: newPwd })
    });
  }

  async function _renderLoginPage(elContainer, bIsTouchLayout, messages, aLanguageOptions, redirectURL, displaysikey) {
    var _pendingUc = null;
    var _reset2FAUc = null;
    var _reset2FAPwd = null;
    var _reset2FAResetToken = null;
    var _isReset2FAFlow = false;
    var _faceIdFlow = false;              // [FaceID] đánh dấu luồng đăng nhập bằng Face ID (để bỏ 2FA)
    var SETUP_2FA_TITLE_DEFAULT = 'Thiết lập xác thực hai lớp';
    var SETUP_2FA_TITLE_RESET = 'Thiết lập lại xác thực 2 lớp';

    // [FaceID] Định nghĩa window.khons MỘT LẦN. Native gọi hàm này để báo trạng thái Face ID.
    window.khons = {
      registerServerFingerStatus: function (status) {
        console.log('registerServerFingerStatus:', status);
        switch (status) {
          case true:                 showToast(MESSAGES.FID_NOT_SETUP, 'warning'); break;   // chưa có creds → chưa thiết lập
          case 'NO_FACEID':          showToast(MESSAGES.FID_NO_SUPPORT, 'warning'); break;
          case 'NO_PERMISSION':      showToast(MESSAGES.FID_NO_PERMISSION, 'warning'); break;
          case 'NOT_ENROLLED':       showToast(MESSAGES.FID_NOT_ENROLLED, 'warning'); break;
          case 'AUTH_FAILED':        showToast(MESSAGES.FID_FAILED, 'warning'); break;
          case 'SENSOR_ERROR':       showToast(MESSAGES.FID_SENSOR, 'warning'); break;
          case 'AUTH_LOCKED':        showToast(MESSAGES.FID_LOCKED, 'warning'); break;
          case 'BIOMETRIC_CHANGED':  showToast(MESSAGES.FID_CHANGED, 'warning'); break;
          case 'AUTH_ERROR':         showToast(MESSAGES.FID_ERROR, 'warning'); break;
          case 'ACCOUNT_MISMATCH':   showToast(MESSAGES.FID_ACCOUNT_MISMATCH, 'warning'); break;
          default: /* false / hủy → không hiển thị */ break;
        }
      }
    };

    $("#setup-2fa-form").on("submit", async function (event) {
      event.preventDefault();
      showLoading();
      try {
        if (_isReset2FAFlow) {
          var code = document.getElementById('setup-otp-input').value;
          var result = await enableReset2FA(_reset2FAResetToken, code);
          if (result.code !== '00') {
            showModalMessage(result.message || MESSAGES.OTP_WRONG);
          } else {
            redirectAfter2FA();
          }
        } else {
          await enable2FA();
        }
      } catch (err) {
        showToast('Đã có lỗi xảy ra, vui lòng thử lại');
      } finally {
        hideLoading();
      }
    });

    $("#setup-2fa-back-link").on("click", function (event) {
      event.preventDefault();
      if (_isReset2FAFlow) {
        _isReset2FAFlow = false;
        document.getElementById('setup-2fa-title').textContent = SETUP_2FA_TITLE_DEFAULT;
        document.getElementById('idUser').value = '';
        document.getElementById('idPassword').value = '';
        _reset2FAPwd = null;
      }
      document.getElementById('setup-2fa-card').setAttribute('hidden', '');
      $('#login-card').show();
    });

    // Eye toggle helper
    function setupEyeToggle(btnId, inputEl) {
      var btn = document.getElementById(btnId);
      if (!btn || !inputEl) return;
      btn.addEventListener('click', function () {
        var isPassword = inputEl.type === 'password';
        inputEl.type = isPassword ? 'text' : 'password';
        btn.querySelector('.icon-eye-on').style.display = isPassword ? 'none' : '';
        btn.querySelector('.icon-eye-off').style.display = isPassword ? '' : 'none';
      });
    }

    var changeNewPwInput = document.getElementById('change-new-password');
    var changeConfirmPwInput = document.getElementById('change-confirm-password');
    setupEyeToggle('toggle-change-new-pw', changeNewPwInput);
    setupEyeToggle('toggle-change-confirm-pw', changeConfirmPwInput);

    var resetPwInput = document.getElementById('reset-2fa-password');
    setupEyeToggle('toggle-reset-2fa-pw', resetPwInput);

    document.getElementById('setup-2fa-link').addEventListener('click', function (event) {
      event.preventDefault();
      $('#login-card').hide();
      document.getElementById('reset-2fa-card').removeAttribute('hidden');
    });

    function backToLoginFromReset2FA() {
      document.getElementById('reset-2fa-card').setAttribute('hidden', '');
      document.getElementById('reset-2fa-form').reset();
      $('#login-card').show();
    }

    document.getElementById('reset-2fa-back-arrow').addEventListener('click', function (event) {
      event.preventDefault();
      backToLoginFromReset2FA();
    });

    document.getElementById('reset-2fa-back-link').addEventListener('click', function (event) {
      event.preventDefault();
      backToLoginFromReset2FA();
    });

    $("#reset-2fa-form").on("submit", async function (event) {
      event.preventDefault();
      var usernameEl = document.getElementById('reset-2fa-username');
      var passwordEl = document.getElementById('reset-2fa-password');
      var errEl = document.getElementById('reset-2fa-error');

      errEl.hidden = true; errEl.textContent = '';
      usernameEl.classList.remove('input-error');
      passwordEl.classList.remove('input-error');

      // Chuẩn hoá giống #loginBtn (trim + lowercase) — nếu không, _reset2FAUc giữ nguyên case
      // gốc và sẽ được gán thẳng vào j_username khi redirectAfter2FA() submit #loginForm,
      // có thể lệch case với tài khoản thật ở OAS → xác thực thất bại → login-failed.jsp.
      var uc = (usernameEl.value || '').trim().toLowerCase();
      var pwd = passwordEl.value || '';

      var contentErr = '';
      if (uc === '') { contentErr = 'Tên đăng nhập'; }
      if (pwd === '') { contentErr = contentErr ? contentErr + ', mật khẩu' : 'Mật khẩu'; }
      if (contentErr !== '') {
        errEl.textContent = contentErr + ' không được để trống!';
        errEl.hidden = false;
        if (uc === '') usernameEl.classList.add('input-error');
        if (pwd === '') passwordEl.classList.add('input-error');
        return;
      }

      showLoading();
      try {
        var verifyResult = await verifyAccount(uc, pwd);
        if (verifyResult.code !== '00') {
          errEl.textContent = verifyResult.message || MESSAGES.LOGIN_WRONG;
          errEl.hidden = false;
          usernameEl.classList.add('input-error');
          passwordEl.classList.add('input-error');
        } else {
          _reset2FAUc = uc;
          _reset2FAPwd = pwd;
          _reset2FAResetToken = verifyResult.data.resetToken;

          document.getElementById('reset-2fa-otp-email').textContent = verifyResult.data.maskedEmail || '';
          $('#reset-2fa-otp-card .otp-cell').val('');
          document.getElementById('reset-2fa-otp-error').hidden = true;

          document.getElementById('reset-2fa-card').setAttribute('hidden', '');
          document.getElementById('reset-2fa-otp-card').removeAttribute('hidden');
          document.querySelector('#reset-2fa-otp-card .otp-cell').focus();
          startResetOtpCountdown(verifyResult.data.otpExpireSeconds || 60);
        }
      } catch (err) {
        showToast('Đã có lỗi xảy ra, vui lòng thử lại');
      } finally {
        hideLoading();
      }
    });

    $("#reset-2fa-otp-card .otp-inputs").on("input", ".otp-cell", function () {
      this.value = this.value.replace(/[^0-9]/g, '').slice(-1);
      var next = $(this).next('.otp-cell');
      if (this.value && next.length) next.focus();
    });

    $("#reset-2fa-otp-card .otp-inputs").on("keydown", ".otp-cell", function (e) {
      if (e.key === 'Backspace' && !this.value) {
        $(this).prev('.otp-cell').focus();
      }
    });

    $("#reset-2fa-otp-card .otp-inputs").on("paste", ".otp-cell", function (e) {
      e.preventDefault();
      var paste = (e.originalEvent.clipboardData || window.clipboardData)
        .getData('text').replace(/[^0-9]/g, '').slice(0, 6);
      var cells = $('#reset-2fa-otp-card .otp-cell');
      paste.split('').forEach(function (d, i) { cells.eq(i).val(d); });
      cells.eq(Math.min(paste.length, 5)).focus();
    });

    function backToLoginFromReset2FAOtp() {
      clearInterval(_resetOtpCountdownTimer);
      document.getElementById('reset-2fa-otp-card').setAttribute('hidden', '');
      document.getElementById('reset-2fa-otp-form').reset();
      $('#login-card').show();
    }

    document.getElementById('reset-2fa-otp-back-arrow').addEventListener('click', function (event) {
      event.preventDefault();
      backToLoginFromReset2FAOtp();
    });

    document.getElementById('reset-2fa-otp-resend-link').addEventListener('click', async function (event) {
      event.preventDefault();
      var otpErrEl = document.getElementById('reset-2fa-otp-error');
      otpErrEl.hidden = true; otpErrEl.textContent = '';

      showLoading();
      try {
        var resendResult = await resendOTP(_reset2FAResetToken);
        if (resendResult.code !== '00') {
          otpErrEl.textContent = resendResult.message;
          otpErrEl.hidden = false;
        } else {
          if (resendResult.data && resendResult.data.resetToken) {
            _reset2FAResetToken = resendResult.data.resetToken;
          }
          $('#reset-2fa-otp-card .otp-cell').val('');
          document.querySelector('#reset-2fa-otp-card .otp-cell').focus();
          startResetOtpCountdown((resendResult.data && resendResult.data.otpExpireSeconds) || 60);
        }
      } catch (err) {
        showToast('Đã có lỗi xảy ra, vui lòng thử lại');
      } finally {
        hideLoading();
      }
    });

    $("#reset-2fa-otp-form").on("submit", async function (event) {
      event.preventDefault();
      var otpErrEl = document.getElementById('reset-2fa-otp-error');
      var code = Array.from(document.querySelectorAll('#reset-2fa-otp-card .otp-cell'))
        .map(function (el) { return el.value; })
        .join('');

      otpErrEl.hidden = true; otpErrEl.textContent = '';

      if (code.length !== 6) {
        otpErrEl.textContent = 'Vui lòng nhập đủ 6 số mã OTP';
        otpErrEl.hidden = false;
        return;
      }

      showLoading();
      try {
        var otpResult = await verifyOTP(_reset2FAResetToken, code);
        if (otpResult.code !== '00') {
          otpErrEl.textContent = otpResult.message || MESSAGES.OTP_WRONG;
          otpErrEl.hidden = false;
        } else {
          clearInterval(_resetOtpCountdownTimer);
          _reset2FAResetToken = otpResult.data.resetToken;
          if (otpResult.data && otpResult.data.qrCode) {
            $('#qrCodeImg').attr('src', otpResult.data.qrCode);
          }

          _isReset2FAFlow = true;
          document.getElementById('setup-2fa-title').textContent = SETUP_2FA_TITLE_RESET;
          document.getElementById('idUser').value = _reset2FAUc;
          // Bug fix: nếu không gán lại mật khẩu, #loginForm submit ở redirectAfter2FA()
          // sẽ gửi j_password rỗng → OAS xác thực thất bại → redirect sai về login-failed.jsp.
          document.getElementById('idPassword').value = _reset2FAPwd;

          document.getElementById('reset-2fa-otp-card').setAttribute('hidden', '');
          document.getElementById('setup-2fa-card').removeAttribute('hidden');
        }
      } catch (err) {
        showToast('Đã có lỗi xảy ra, vui lòng thử lại');
      } finally {
        hideLoading();
      }
    });

    var PW_REGEX = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{8,}$/;

    $("#change-pw-form").on("submit", async function (event) {
      event.preventDefault();
      var newPw = (changeNewPwInput.value || '').trim();
      var confirmPw = (changeConfirmPwInput.value || '').trim();
      var newPwErr = document.getElementById('change-new-pw-error');
      var confirmPwErr = document.getElementById('change-confirm-pw-error');

      newPwErr.hidden = true; newPwErr.textContent = '';
      confirmPwErr.hidden = true; confirmPwErr.textContent = '';
      changeNewPwInput.classList.remove('input-error');
      changeConfirmPwInput.classList.remove('input-error');

      var isValid = true;
      if (!newPw) {
        newPwErr.textContent = MESSAGES.CHANGE_PW_EMPTY; newPwErr.hidden = false;    // #5
        changeNewPwInput.classList.add('input-error'); isValid = false;
      } else if (!PW_REGEX.test(newPw)) {
        newPwErr.textContent = MESSAGES.CHANGE_PW_POLICY; newPwErr.hidden = false;   // #6
        changeNewPwInput.classList.add('input-error'); isValid = false;
      }
      if (!confirmPw) {
        confirmPwErr.textContent = MESSAGES.CHANGE_PW_CONFIRM_EMPTY; confirmPwErr.hidden = false;
        changeConfirmPwInput.classList.add('input-error'); isValid = false;
      } else if (confirmPw !== newPw) {
        confirmPwErr.textContent = MESSAGES.CHANGE_PW_MISMATCH; confirmPwErr.hidden = false; // #7
        changeConfirmPwInput.classList.add('input-error'); isValid = false;
      }
      if (!isValid) return;

      var oldPwd = document.getElementById('idPassword').value;
      showLoading();
      try {
        try {
          await changePassword(_pendingUc, oldPwd, newPw);
        } catch (e) {
          console.warn('changePassword lỗi, tạm bỏ qua:', e);
        }

        // [FaceID] Luồng Face ID: đổi mật khẩu xong → VÀO THẲNG, KHÔNG thiết lập 2FA (spec 10.5.2).
        if (_faceIdFlow) {
          showToast(MESSAGES.CHANGE_PW_SUCCESS, 'success');   // #8
          // Đã đăng nhập bằng Face ID rồi đổi mật khẩu → cập nhật lại credential đã lưu
          // (im lặng, không cần quét lại) để Face ID lần sau dùng mật khẩu mới.
          if (window.ReactNativeWebView) {
            _sendNative('setup_sinhtrachoc', { username: document.getElementById('idUser').value, password: newPw });
          }
          document.getElementById('change-pw-card').setAttribute('hidden', '');
          redirectAfter2FA();
          return;
        }

        // Luồng thường: đổi mật khẩu thành công → chuyển sang setup 2FA
        // Bug fix: nếu không gán lại mật khẩu, #loginForm submit ở redirectAfter2FA()
        // (sau khi enable2FA) sẽ gửi j_password là mật khẩu CŨ → OAS xác thực thất bại
        // → redirect sai về login-failed.jsp.
        document.getElementById('idPassword').value = newPw;

        var result2FA = await setup2FA(_pendingUc);
        if (result2FA.data && result2FA.data.qrCode) {
          $('#qrCodeImg').attr('src', result2FA.data.qrCode);
          _isReset2FAFlow = false;
          document.getElementById('setup-2fa-title').textContent = SETUP_2FA_TITLE_DEFAULT;
          document.getElementById('change-pw-card').setAttribute('hidden', '');
          document.getElementById('setup-2fa-card').removeAttribute('hidden');
        }
      } catch (err) {
        showToast('Đã có lỗi xảy ra, vui lòng thử lại');
      } finally {
        hideLoading();
      }
    });

    $("#verify-2fa-form").on("submit", async function (event) {
      event.preventDefault();
      showLoading();
      try {
        await verify2FA();
      } catch (err) {
        showToast('Đã có lỗi xảy ra, vui lòng thử lại');
      } finally {
        hideLoading();
      }
    });

    $("#verify-2fa-card .otp-inputs").on("input", ".otp-cell", function () {
      this.value = this.value.replace(/[^0-9]/g, '').slice(-1);
      var next = $(this).next('.otp-cell');
      if (this.value && next.length) next.focus();
    });

    $("#verify-2fa-card .otp-inputs").on("keydown", ".otp-cell", function (e) {
      if (e.key === 'Backspace' && !this.value) {
        $(this).prev('.otp-cell').focus();
      }
    });

    $("#verify-2fa-card .otp-inputs").on("paste", ".otp-cell", function (e) {
      e.preventDefault();
      var paste = (e.originalEvent.clipboardData || window.clipboardData)
        .getData('text').replace(/[^0-9]/g, '').slice(0, 6);
      var cells = $('#verify-2fa-card .otp-cell');
      paste.split('').forEach(function (d, i) { cells.eq(i).val(d); });
      cells.eq(Math.min(paste.length, 5)).focus();
    });

    // [AccountStatus] Đọc /auth/account-status sau khi login thành công. Chỉ hiện toast/mở popup
    // với các cờ được yêu cầu; các cờ khác (accountExpiresAt, badPwdCount...) bỏ qua.
    // Trả về true nếu cần DỪNG luồng (không tiếp tục sang bước 2FA/Face ID).
    function handleAccountStatus(status, uc) {
      // if (!status) return false;
      // if (status.exists === false) { showToast(MESSAGES.ACC_NOT_EXIST, 'warning'); return true; }
      // if (status.active === false) { showToast(MESSAGES.ACC_NOT_ACTIVE, 'warning'); return true; }
      // if (status.disabled === true) { showToast(MESSAGES.ACC_DISABLED, 'warning'); return true; }
      // if (status.locked === true) { showToast(MESSAGES.ACC_LOCKED, 'warning'); return true; }
      // if (status.accountExpired === true) { showToast(MESSAGES.ACC_EXPIRED, 'warning'); return true; }
      // if (status.passwordExpired === true) { showToast(MESSAGES.ACC_PWD_EXPIRED, 'warning'); return true; }
      if (status.mustChangePassword === true) {
        _pendingUc = uc;
        $('#login-card').hide();
        document.getElementById('change-pw-card').removeAttribute('hidden');
        return true;
      }
      return false;
    }

    // [FaceID] Điều hướng sau khi login() thành công — dùng chung cho đăng nhập tay & Face ID.
    // viaFaceId = true  → BỎ QUA 2FA (spec 10.5.2): vào thẳng (hoặc hỏi đổi thiết bị).
    // viaFaceId = false → is2FAEnabled=false → setup 2FA; =true → nhập OTP verify.
    // (Tạm comment logic đổi mật khẩu — không còn hiện change-pw-card sau login.)
    async function handleLoginSuccess(loginResult, viaFaceId) {
      var d = loginResult.data || {};
      var uc = d.uc;
      _pendingUc = uc;

      // [Review] Tài khoản đánh giá store: bỏ qua 2FA và KHÔNG submit #loginForm.
      // Đặt trước mọi nhánh khác — kể cả Face ID — vì tài khoản này chỉ có trên OAS nên
      // is2FAEnabled=false, mà nhánh false bên dưới là "ép thiết lập 2FA bằng QR".
      // So sánh === true để undefined ở bản IDA cũ không lọt thành truthy.
      if (d.reviewAccount === true) {
        await preEnableBiometricThenGoToDemo(uc);
        return;
      }

      // // [BE] backend cần trả passwordChangeRequired; tạm suy từ is2FAEnabled nếu chưa có.
      // var pwChange = (typeof d.passwordChangeRequired !== 'undefined')
      //   ? d.passwordChangeRequired
      //   : (!d.is2FAEnabled);

      if (viaFaceId) {
        // if (pwChange) {
        //   _faceIdFlow = true;                          // để change-pw handler bỏ qua setup 2FA
        //   $('#login-card').hide();
        //   document.getElementById('change-pw-card').removeAttribute('hidden');
        // } else
        if (d.otherDeviceLoggedIn) {            // [BE] #13: đang đăng nhập thiết bị khác
          showConfirmModal(
            MESSAGES.OTHER_DEVICE_TITLE, MESSAGES.OTHER_DEVICE_BODY,
            MESSAGES.OTHER_DEVICE_OK, MESSAGES.OTHER_DEVICE_CANCEL,
            async function () {                        // Tiếp tục đăng nhập → đăng xuất máy cũ
              showLoading();
              try { await forceLoginNewDevice(uc); } catch (e) { /* ignore */ } finally { hideLoading(); }
              redirectAfter2FA();
            },
            function () { /* Hủy → ở lại 1018.MH01 */ }
          );
        } else {
          redirectAfter2FA();                          // vào thẳng, không 2FA
        }
        return;
      }

      // ----- Luồng đăng nhập tay -----
      var skip2FA = window.location.href.includes('skip2FA');
      var userName = $('#idUser').val();
      var BY_PASS_USER = [
        'weblogic', 'devoas', 'devstc', 'devptc', 'ioc_btc', 
        'ioc_stc', 'ioc_ptc', 'khotc-qt1', 'odi_uat_ioc1', 
        'csdl_btc', 'csdl_stc', 'csdl_ptc', 'khotc-qt2', 
        'odi_uat_qg1', 'luyenttt', 'stchanoi1', 'ptchoaiduc', 
        'phuonglang1', 'nguyenthuha1'];
      if (skip2FA || BY_PASS_USER.includes(userName)) {
        redirectAfter2FA();
      // } else if (pwChange) {
      //   $('#login-card').hide();
      //   document.getElementById('change-pw-card').removeAttribute('hidden');
      } else if (!d.is2FAEnabled) {
        // Chưa bật 2FA → gọi setup-2fa, hiện card QR ngay (bỏ bước đổi mật khẩu).
        var result2FA = await setup2FA(uc);
        if (result2FA.data && result2FA.data.qrCode) {
          $('#qrCodeImg').attr('src', result2FA.data.qrCode);
          _isReset2FAFlow = false;
          document.getElementById('setup-2fa-title').textContent = SETUP_2FA_TITLE_DEFAULT;
          $('#login-card').hide();
          document.getElementById('setup-2fa-card').removeAttribute('hidden');
        } else {
          showToast((result2FA && result2FA.message) || 'Không thể thiết lập xác thực hai lớp. Vui lòng thử lại');
        }
      } else {
        $('#login-card').hide();
        document.getElementById('verify-2fa-card').removeAttribute('hidden');
        document.querySelector('#verify-2fa-card .otp-cell').focus();
        startOtpCountdown();
      }
    }

    $("#loginBtn").on("click", async function (event) {
      // [FaceID] Đọc & reset cờ ngay đầu handler để lần click thủ công sau không bị "dính" cờ.
      var viaFaceId = !!window.__faceIdLogin;
      window.__faceIdLogin = false;

      $('#idUser').val($.trim($('#idUser').val().toLowerCase()));
      $('#idPassword').val($.trim($('#idPassword').val()));

      const idUser = $('#idUser').val();
      const idPassword = $('#idPassword').val();

      var contentErr = '';
      if (idUser === '') { contentErr = 'Tên đăng nhập'; }
      if (idPassword === '') { contentErr = contentErr != '' ? contentErr + ', mật khẩu' : 'Mật khẩu'; }

      if (contentErr != '') {
        // Với luồng Face ID, creds rỗng nghĩa là chưa lưu → không hiện lỗi "để trống".
        if (!viaFaceId) showModalMessage(contentErr + ' không được để trống!');
        return false;
      }

      localStorage.setItem("username", idUser);

      showLoading();
      try {
        // [FaceID] Face ID có thể đã bị TẮT cho tài khoản này từ BE (trang chủ / gọi thẳng
        // API change-status) mà thiết bị chưa được báo → hỏi lại BE trước khi dùng creds cũ.
        if (viaFaceId) {
          const stillEnabled = await isFaceIdEnabledOnServer(idUser);
          if (!stillEnabled) {
            _sendNative('remove_token-by-sinhtrachoc');
            showToast(MESSAGES.FID_DISABLED, 'warning');
            return;
          }
        }

        const loginResult = await login();
        if (loginResult.code !== '00') {
          if (viaFaceId) {
            // Creds Face ID đã lưu không còn hợp lệ (mật khẩu đã đổi/reset/hết hạn ở nơi khác)
            // → XÓA credential cũ trên thiết bị để không lặp lỗi, và yêu cầu bật lại Face ID.
            _sendNative('remove_token-by-sinhtrachoc');
            showToast(MESSAGES.FID_STALE, 'warning');
          } else {
            var loginErrEl = document.getElementById('login-error');
            if (loginErrEl) { loginErrEl.textContent = loginResult.message || MESSAGES.LOGIN_WRONG; loginErrEl.hidden = false; }
            document.getElementById('idUser').classList.add('input-error');
            document.getElementById('idPassword').classList.add('input-error');
          }
          return;
        }

        var loginUc = (loginResult.data && loginResult.data.uc) || idUser;

        // [AccountStatus] Kiểm tra trạng thái tài khoản ngay sau khi login thành công.
        // Fail-open: lỗi/timeout gọi API thì bỏ qua, không chặn luồng đăng nhập.
        try {
          var accountStatusRes = await getAccountStatus(loginUc);
          if (accountStatusRes && accountStatusRes.data && handleAccountStatus(accountStatusRes.data, loginUc)) {
            return;
          }
        } catch (e) {
          console.warn('getAccountStatus lỗi, tạm bỏ qua:', e);
        }

        // [AccountStatus] Lấy is2FAEnabled mới nhất để quyết định luồng setup/verify 2FA.
        try {
          var authStatusRes = await getAuthStatus(loginUc);
          if (authStatusRes && authStatusRes.data) {
            loginResult.data = loginResult.data || {};
            loginResult.data.is2FAEnabled = authStatusRes.data.is2FAEnabled;
            // Kiểm typeof: bản IDA cũ chưa có field, không được ghi đè giá trị đã lấy từ
            // /auth/login bằng undefined.
            if (typeof authStatusRes.data.reviewAccount !== 'undefined') {
              loginResult.data.reviewAccount = authStatusRes.data.reviewAccount;
            }
          }
        } catch (e) {
          console.warn('getAuthStatus lỗi, tạm bỏ qua:', e);
        }

        // Không tự lưu/không hỏi bật Face ID ở trang login nữa.
        // Việc BẬT/TẮT Face ID do người dùng chủ động qua nút gạt ở TRANG CHỦ (user.js + faceid-bridge.js).
        await handleLoginSuccess(loginResult, viaFaceId);
      } catch (err) {
        showToast('Đã có lỗi xảy ra, vui lòng thử lại');
      } finally {
        hideLoading();
      }
    });

    // [Cleanup 2026-08-05] Đã xoá handler legacy #loginBtn2 (GET /mailapi/checkmail):
    // #loginBtn2 và #idPin không còn tồn tại trong login.jsp nên handler không bao giờ chạy;
    // context /mailapi cũng không còn được OHS map (probe qua tên miền → 404).
    // Xác thực OTP 2FA hiện đi qua verify2FA() → /auth/verify-2fa.

    // [FaceID] Nút "Đăng nhập bằng Face ID" — chỉ gửi yêu cầu; window.khons đã định nghĩa 1 lần ở trên.
    $(".touch-id-Icons").on("click", function (event) {
      if (event && event.preventDefault) event.preventDefault();   // <a href="#">
      if (window.ReactNativeWebView) {
        // Gửi kèm tài khoản đang gõ (trim + lowercase, khớp chuẩn hoá lúc đăng nhập)
        // để native chặn nếu Face ID đang gắn tài khoản KHÁC → tránh đăng nhập nhầm.
        var typedUser = ($.trim($('#idUser').val() || '')).toLowerCase();
        window.ReactNativeWebView.postMessage(JSON.stringify({
          result: 'OK', data: { action: "finger_login", username: typedUser }
        }));
      } else {
        // Mở ngoài app (trình duyệt web thường) → không hỗ trợ Face ID.
        showToast(MESSAGES.FID_NO_SUPPORT, 'warning');
      }
    });

    // [FaceID] Thiết lập/bật Face ID (nếu login.jsp có phần tử .touch-id-setUp).
    $(".touch-id-setUp").on("click", function (event) {
      if (event && event.preventDefault) event.preventDefault();
      if (window.ReactNativeWebView) {
        window.ReactNativeWebView.postMessage(JSON.stringify({
          result: 'OK', data: { action: "setup_fingerprint" }
        }));
      }
    });

  }

  var langParam = getParameter('lang');

  if (langParam === undefined || langParam == '') {
    langParam = window.navigator.userLanguage || window.navigator.language;
  }
  var langAbbr = [
    "en", "hr", "ro", "da", "it", "tr", "no", "ko", "cs", "de",
    "zh-CN", "zh-TW", "el", "fi", "pl", "pt-PT", "pt", "sv", "fr", "ru",
    "fr-CA", "es", "ja", "ar", "he", "hu", "nl", "sk", "th"
  ];

  var langParamExact = "";
  var langParamShort = "";
  var langParamLocale = "";
  for (var i = 0; i < langAbbr.length; i++) {
    var sLangAbbr = langAbbr[i];
    if ((typeof sLangAbbr === 'string') && (sLangAbbr !== "")) {
      if (sLangAbbr === langParam) {
        langParamExact = sLangAbbr;
        break;
      } else if (langParam.indexOf(sLangAbbr) == 0) {
        langParamShort = sLangAbbr;
      } else if (langParam.indexOf(sLangAbbr.substring(0, 2)) == 0) {
        langParamLocale = sLangAbbr;
      }
    }
  }

  if ((typeof langParamExact === 'string') && (langParamExact !== langParam)) {
    if ((typeof langParamLocale === 'string') && (langParamLocale !== "")) {
      langParam = langParamLocale;
    }
    if ((typeof langParamShort === 'string') && (langParamShort !== "")) {
      langParam = langParamShort;
    }
  }

  if (langParamExact === "" && langParamShort === "" && langParamLocale === "") {
    langParam = 'en';
  }

  var messagePath = 'nls/' + langParam + '/messages';

  //NOTE: require.js MUST BE LOADED IN PAGE ALREADY
  require(['jquery',
    'knockout',
    'js/useragent',
    'js/languages',
    'js/responsiveutils-definitions',
    messagePath,
    'ojs/ojcore',
    'ojs/ojknockout',
    'ojs/ojswitch',
    'ojs/ojselectcombobox'
  ],
    function ($, ko, useragent, languages, rudef, messages) {
      //Validate login page has a root container
      if (elContainer === null || elContainer === undefined) {
        elContainer = document.body;
      }

      //Inject CSS into HTML container
      var bIsTouchLayout = useragent.userAgent.is_touchdevice;
      var eScreenSize = rudef.getScreenSize();
      rudef.setResponsiveUtilsClasses(elContainer, bIsTouchLayout, eScreenSize);

      //Add in screen size change listener
      if (!(window.matchMedia === null || window.matchMedia === undefined)) {
        var fUpdateResponsiveUtilsClasses = function () {
          if ($(".bitech-rootlogin").length > 0) {
            var eNewScreenSize = rudef.getScreenSize();
            rudef.setResponsiveUtilsClasses(elContainer, bIsTouchLayout, eNewScreenSize);
          }
        };
        var aaMediaQueries = rudef.SCREEN_SIZE_QUERY;
        for (var sSizeType in aaMediaQueries) {
          var sQuery = aaMediaQueries[sSizeType];
          var oSizeMatch = window.matchMedia(sQuery);
          oSizeMatch.addListener(fUpdateResponsiveUtilsClasses);
        }
      }

      function switchLangParam(paramName, paramValue) {
        var url = window.location.href;
        var hash = location.hash;
        url = url.replace(hash, '');
        if (url.indexOf(paramName + "=") >= 0) {
          var prefix = url.substring(0, url.indexOf(paramName));
          var suffix = url.substring(url.indexOf(paramName));
          suffix = suffix.substring(suffix.indexOf("=") + 1);
          suffix = (suffix.indexOf("&") >= 0) ? suffix.substring(suffix.indexOf("&")) : "";
          url = prefix + paramName + "=" + paramValue + suffix;
        } else {
          if (url.indexOf("?") < 0)
            url += "?" + paramName + "=" + paramValue;
          else
            url += "&" + paramName + "=" + paramValue;
        }
        window.location.href = url + hash;
      }

      //Render the login page content
      var oLoginMessages = messages.login;
      var oLanguageOptions = languages.generateLanguageOptions();

      this.optionChangedHandler = function (event, data) {
        if (data.option == "value") {
          var selectedVal = data.value;
          switchLangParam('lang', selectedVal);
        }
      }

      var redirectURL = getParameter("redirect");
      var displaysikey = getParameter("msi");
      if (displaysikey != 'undefined' && displaysikey == 'true') {
        displaysikey = 'block';
      } else {
        displaysikey = 'none';
      }

      _renderLoginPage(elContainer, bIsTouchLayout, oLoginMessages, oLanguageOptions, redirectURL, displaysikey);

      function SwitchModel() {
        this.isChecked = ko.observable();
      }

      function ValueModel() { }
    });
};