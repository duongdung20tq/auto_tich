// [Review] Bật sẵn đăng nhập sinh trắc cho tài khoản đánh giá store, rồi mới sang trang trình diễn.
//
// Dùng action 'enable_faceid', KHÔNG dùng 'setup_sinhtrachoc':
//   - enable_faceid bắt quét sinh trắc để xác nhận rồi mới lưu credential → giữ đúng mô hình đồng
//     thuận của app ("chủ máy đồng ý mới gắn credential"), và reviewer thấy ngay prompt native.
//   - setup_sinhtrachoc lưu IM LẶNG, lại gọi về registerServerFingerStatus(true) mà nhánh `true`
//     map thành toast "chưa thiết lập" — tức là hiện một thông báo SAI.
//
// LUÔN đi tiếp sang trang demo, dù bật được hay không:
//   - máy reviewer có thể không có hoặc chưa đăng ký sinh trắc → trả NO_FACEID / NOT_ENROLLED;
//   - bản app CŨ chưa có handler 'enable_faceid' sẽ không gọi lại gì cả → bắt buộc phải có watchdog,
//     nếu không reviewer kẹt vĩnh viễn ở màn đăng nhập. Đây là lỗi đắt nhất có thể xảy ra ở đây.
// Không hiện toast lỗi cho tài khoản đánh giá: một thông báo lỗi giữa vòng review đắt hơn nhiều so
// với việc lặng lẽ bỏ qua một tính năng phụ.
function preEnableBiometricThenGoToDemo(uc) {
  return new Promise(function (resolve) {
    var timer;
    var done = false;
    var go = function () {
      if (done) return;
      done = true;
      clearTimeout(timer);
      // Native có thể trả lời MUỘN, sau khi đã sang trang demo (trang đó không định nghĩa khons)
      // → để lại một no-op cho lần gọi muộn khỏi ném lỗi.
      window.khons.onEnableFaceidResult = function () {};
      window.location.replace(reviewDemoUrl());
      resolve();
    };

    window.khons = window.khons || {};

    // Mở ngoài app (trình duyệt thường): không có cầu native, đi thẳng.
    if (!window.ReactNativeWebView) { go(); return; }

    var pwdEl = document.getElementById('idPassword');
    var pwd = pwdEl ? pwdEl.value : '';
    if (!pwd) { go(); return; }        // đăng nhập bằng Face ID sẵn có → không cần bật lại

    window.khons.onEnableFaceidResult = function (code) {
      console.log('[review] enable_faceid:', code);   // ENABLED | NO_FACEID | NOT_ENROLLED | CANCELLED…
      go();
    };
    // 20s: đủ rộng cho một lượt quét sinh trắc của người dùng, mà vẫn không kẹt vô hạn.
    timer = setTimeout(go, 20000);
    _sendNative('enable_faceid', { username: uc, password: pwd });
  });
}
var _BOUNCE_FLAG = 'oasRedirectBounced';

// [Fix redirect] Lay NGUYEN VAN gia tri cua tham so "redirect", cat tai '&' dau tien.
//
// KHONG dung URLSearchParams.get('redirect'): ham do decode %xx va doi '+' thanh ' ',
// lam sai tham so hash ma OAS da ky.
//
// KHONG lay den het query string (nhu ban OOTB getParameter() o tren, va nhu v3 truoc day):
// gia tri redirect cua OAS luon la base64 nen KHONG BAO GIO chua '&', trong khi co nhung
// duong sinh ra URL co tham so DUNG SAU redirect:
//   - LoginServlet khi xac thuc that bai: login-failed.jsp?...&redirect=<R>&useProfileSetting=false&lang=en
//   - switchLangParam() (cuoi file) noi '&lang=xx' vao URL hien tai khi doi ngon ngu
// Do thuc te: gui j_redirect = <R> + '&lang=en' -> HTTP 400 "The redirect URL is not valid!".
function getRawRedirectParam() {
  var qs = window.location.search.substring(1);
  var m = /(?:^|&)redirect=([^&]*)/.exec(qs);
  return (m && m[1]) ? m[1] : null;
}

// Buoc cuoi cua moi luong FE: submit #loginForm.
// POST /bi-security-login/login la buoc DUY NHAT tao phien OAS/WebLogic
// (container xac thuc j_username/j_password) -> KHONG BAO GIO duoc bo qua buoc submit nay.
//
// Quy tac gan j_redirect - do thuc te tren 10.15.119.111:7102 (POST voi user khong ton tai):
//   | j_redirect                                  | LoginServlet tra ve                     |
//   |---------------------------------------------|-----------------------------------------|
//   | redirect that tu URL (co hash OAS ky)       | 302 -> di tiep buoc xac thuc            |
//   | RONG / khong gui                            | 302 -> di tiep buoc xac thuc            |
//   | base64 tu tao, khong co hash                | 400 "The redirect URL is not valid!"    |
//   | hash cu (hardcode trong login.jsp truoc day)| 400 "The redirect URL is not valid!"    |
// => Chi co 2 gia tri dung duoc: chuoi redirect that, hoac RONG. Kiem tra nay chay TRUOC
//    khi xac thuc, nen gui sai la mat luon phien dang nhap.
//
// LICH SU:
//   v1: thieu redirect -> dieu huong /analytics roi RETURN => khong submit => khong co phien
//       => analytics bao "You are not currently signed in". Da bo.
//   v2: thieu redirect -> gui base64 tu tao => 400 "The redirect URL is not valid!". Da bo.
function redirectAfter2FA() {
  var redirectParam = getRawRedirectParam();
  var redirectInput = document.querySelector('input[name="j_redirect"]');

  if (!redirectParam) {
    console.warn('redirectAfter2FA: thieu tham so "redirect" tren URL -> gui j_redirect rong');
  }

  if (redirectInput) {
    // Co redirect: truyen lai NGUYEN VEN (khong decode/encode lai). Khong co: gui rong.
    redirectInput.value = redirectParam || '';
  }

  $('#loginForm').submit();
}

// [Fix redirect] Bao dam trang login luon co tham so "redirect" hop le.
// Da kiem chung: GET /analytics -> 302 -> /bi-security-login/login.jsp?msi=false&mt=false
// &profileMust=true&redirect=<base64 co hash>. Nen khi trang login duoc mo TRUC TIEP
// (khong co redirect), di qua OAS_ENTRY_PATH mot lan de OAS cap redirect moi roi bat ve day.
// Co co sessionStorage chong lap vo han khi OAS khong bat ve (moi truong cau hinh khac).
function ensureRedirectParam() {
  if (!document.getElementById('loginForm')) {
    return;                                   // khong phai trang login -> khong lam gi
  }
  if (getRawRedirectParam()) {
    try { sessionStorage.removeItem(_BOUNCE_FLAG); } catch (e) { /* private mode */ }
    return;
  }
  var bounced = '1';
  try { bounced = sessionStorage.getItem(_BOUNCE_FLAG); } catch (e) { /* private mode */ }
  if (bounced) {
    console.warn('ensureRedirectParam: da thu qua ' + OAS_ENTRY_PATH
      + ' nhung van thieu tham so redirect -> giu nguyen trang login');
    return;
  }
  try { sessionStorage.setItem(_BOUNCE_FLAG, '1'); } catch (e) { /* private mode */ }
  console.warn('ensureRedirectParam: thieu tham so redirect -> di qua ' + OAS_ENTRY_PATH
    + ' de OAS cap redirect moi');
  window.location.replace(OAS_ENTRY_PATH);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', ensureRedirectParam);
} else {
  ensureRedirectParam();
}

// Gửi message tới native. Dùng cho việc cập nhật credential IM LẶNG khi đổi mật khẩu
// ngay sau khi đã đăng nhập bằng Face ID (giữ token_khonsnn khớp mật khẩu mới).
// BẬT/TẮT Face ID được quản lý ở TRANG CHỦ qua nút gạt (user.js + faceid-bridge.js), không ở trang login.
function _sendNative(action, extra) {
  if (window.ReactNativeWebView) {
    window.ReactNativeWebView.postMessage(JSON.stringify({
      result: 'OK', data: Object.assign({ action: action }, extra || {})
    }));
  }
}

// Check cấu hình Face ID còn BẬT không — dùng endpoint READ-ONLY sẵn có (config/detail),
// Có timeout; lỗi/timeout → fail-open (coi như còn bật, không khoá người dùng). Trả Promise<boolean>.
function isFaceIdEnabledOnServer(uc) {
  var ctrl = new AbortController();
  var timer = setTimeout(function () { ctrl.abort(); }, 4000);
  return fetchJson(`/auth/config/detail?uc=${encodeURIComponent(uc)}`, {
    headers: { 'Accept': 'application/json' },
    signal: ctrl.signal
  })
    .then(function (d) {
      clearTimeout(timer);
      // Chỉ coi là TẮT khi BE trả rõ ràng faceIdEnabled === false. Còn lại → cho qua.
      return !(d && d.code === '00' && d.data && d.data.faceIdEnabled === false);
    })
    .catch(function () { clearTimeout(timer); return true; });
}

// [AccountStatus] GET /auth/status?uc=... — luồng setup 2FA có đang bật cho tài khoản không (is2FAEnabled).
function getAuthStatus(uc) {
  return fetchJson(`/auth/status?uc=${encodeURIComponent(uc)}`, {
    headers: { 'Accept': 'application/json' }
  });
}

// [AccountStatus] GET /auth/account-status?uc=... — trạng thái tài khoản (khóa/hết hạn/đổi mật khẩu...).
function getAccountStatus(uc) {
  return fetchJson(`/auth/account-status?uc=${encodeURIComponent(uc)}`, {
    headers: { 'Accept': 'application/json' }
  });
}

// Loading overlay với counter để tránh ẩn overlay
// sớm khi có nhiều lời gọi API chạy song song/lồng nhau.
var _loadingCounter = 0;

function showLoading() {
  _loadingCounter++;
  var overlay = document.getElementById('login-loading-overlay');
  if (overlay) overlay.hidden = false;
}

function hideLoading() {
  _loadingCounter = Math.max(0, _loadingCounter - 1);
  if (_loadingCounter === 0) {
    var overlay = document.getElementById('login-loading-overlay');
    if (overlay) overlay.hidden = true;
  }
}

// [Toast] Dùng module Toast chung (btc-fe/packages/static-resource/assets/modules/toast).
// Giữ lại showToast(msg, type) làm shim mỏng để không phải sửa mọi nơi gọi trong file này.
// type: 'success' / 'warning' / 'error' / true (bwd-compat, coi như 'success'); không truyền → 'error'.
function showToast(msg, type) {
  if (type === true) type = 'success'; // backward compatibility
  Toast.show(msg, type || 'error');
}

// [FaceID] Modal 1 nút (thông báo) — dùng #thongBaoSinhTracHoc có sẵn trong login.jsp.
function showModalMessage(html) {
  $("#thongBaoSinhTracHoc #conf-3").html(html);
  $("#thongBaoSinhTracHoc .nut").html('<a href="#" class="luu" id="sure-do">Xác nhận</a>');
  $("#thongBaoSinhTracHoc .nut .luu").off('click').on('click', function (e) {
    e.preventDefault();
    $('#thongBaoSinhTracHoc').removeClass('show-modal');
  });
  $('#thongBaoSinhTracHoc').addClass('show-modal');
}

// [FaceID] Modal xác nhận 2 nút (pop-up #10/#13: đổi thiết bị đăng nhập).
function showConfirmModal(title, body, okText, cancelText, onOk, onCancel) {
  var html = (title ? '<strong>' + title + '</strong><br>' : '') + body;
  $("#thongBaoSinhTracHoc #conf-3").html(html);
  var $nut = $("#thongBaoSinhTracHoc .nut").empty();
  var $cancel = $('<a href="#" class="luu" style="background:#fff;color:#1378C8 !important;border-color:#1378C8;">' + cancelText + '</a>');
  var $ok = $('<a href="#" class="luu">' + okText + '</a>');
  $cancel.on('click', function (e) {
    e.preventDefault();
    $('#thongBaoSinhTracHoc').removeClass('show-modal');
    if (onCancel) onCancel();
  });
  $ok.on('click', function (e) {
    e.preventDefault();
    $('#thongBaoSinhTracHoc').removeClass('show-modal');
    if (onOk) onOk();
  });
  $nut.append($cancel).append($ok);
  $('#thongBaoSinhTracHoc').addClass('show-modal');
}

async function enable2FA() {
  const data = await fetchJson(
    '/auth/enable-2fa',
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8' },
      body: JSON.stringify({
        uc: document.getElementById('idUser').value,
        code: document.getElementById('setup-otp-input').value,
      })
    }
  );

  // [Fix check-code] BE tra ApiResponse{code,message,data}: loi = code '01' (kem HTTP 400),
  // khong co field "error". Check data.error luon false -> truoc day loi van di tiep
  // sang redirectAfter2FA() va nguoi dung nhan thong bao redirect thay vi loi thuc.
  if (data.code !== '00') {
    showModalMessage(data.message || MESSAGES.OTP_WRONG);
  } else {
    redirectAfter2FA();
  }
}

async function toggle2FA() {
  const data = await fetchJson(
    '/auth/toggle-2fa-status',
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8' },
      body: JSON.stringify({
        uc: document.getElementById('idUser').value,
        isEnabled: false,
        password: document.getElementById('idPassword').value,
      })
    }
  );

  // [Fix check-code] xem giai thich o enable2FA().
  if (data.code !== '00') {
    showModalMessage(data.message);
  } else {
    redirectAfter2FA();
  }
}

async function verify2FA() {
  const code = Array.from(document.querySelectorAll('.otp-cell'))
    .map(function (el) { return el.value; })
    .join('');

  const data = await fetchJson(
    '/auth/verify-2fa',
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=UTF-8' },
      body: JSON.stringify({
        uc: document.getElementById('idUser').value,
        code: code,
      })
    }
  );

  if (data.code === "01") {
    var errEl = document.getElementById('verify-otp-error');
    if (errEl) { errEl.textContent = data.message || MESSAGES.OTP_WRONG; errEl.hidden = false; }
  } else {
    redirectAfter2FA();
  }
}

