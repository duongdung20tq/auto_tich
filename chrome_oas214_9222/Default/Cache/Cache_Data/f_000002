// ─────────────────────────────────────────────────────────────────────────────
// [API] Cấu hình theo môi trường — KHÔNG hardcode host/port riêng cho từng env.
//
// Service `identity-authenticator` deploy dạng WAR trên WebLogic, context-root
// `/identity-authenticator`, CÙNG managed server phục vụ /analytics (cổng 7102).
// Do đó trang login và API luôn CÙNG ORIGIN ⇒ base URL để RỖNG (relative):
//   dev/test/uat nội bộ : http://<host>:7102/analytics/...  → API /identity-authenticator/...
//   prod qua tên miền   : https://ioc.mof.gov.vn/...        → API /identity-authenticator/...
// Không còn URL tuyệt đối ⇒ không mixed content (https→http), không CORS,
// không phụ thuộc IP nội bộ (client mobile ngoài mạng không tới được IP private).
//
// CHỈ khi service chạy STANDALONE khác origin (dev máy cá nhân: java -jar, cổng
// 8001) mới cần trỏ đi nơi khác — khai báo TRƯỚC khi nạp file này, trong login.jsp:
//   <script>window.__IA_API_ORIGIN__ = 'http://localhost:8001';</script>
// (khi đó BE phải bật CORS cho origin của trang).
//
// [F5] Qua TÊN MIỀN thì request đi F5(ASM) → OHS → WLS. ASM chặn URI có ≥4 đoạn
// path: verify 2026-08-05 `/identity-authenticator/auth/config/detail` → HTTP 200
// + HTML "Request Rejected", Support ID 9878758138658642663. Nên 6 endpoint "sâu"
// phải gọi qua alias 3 đoạn mà OHS đã ProxyPass về path thật:
//   /identity-authenticator/cfg      → .../auth/config
//   /identity-authenticator/reset2fa → .../auth/reset-2fa
// Vào THẲNG WLS bằng IP:7102 thì không có F5/OHS ⇒ phải gọi path thật.
// Xem memory prod-waf-blocks-mainmobile.
// ─────────────────────────────────────────────────────────────────────────────
const API_CTX    = '/identity-authenticator';
const API_ORIGIN = (typeof window !== 'undefined' && window.__IA_API_ORIGIN__) || '';  // '' = same-origin
// Có F5+OHS ở giữa khi trang mở bằng TÊN MIỀN (không phải IP/localhost) và không override origin.
const VIA_GATEWAY = !API_ORIGIN && !/^(\d{1,3}\.){3}\d{1,3}$|^localhost$/i.test(location.hostname);
const F5_DEEP_ALIAS = {                    // phải khớp ProxyPass trên OHS
  '/auth/config/detail':            '/cfg/detail',
  '/auth/config/change-status':     '/cfg/change-status',
  '/auth/reset-2fa/verify-account': '/reset2fa/verify-account',
  '/auth/reset-2fa/verify-otp':     '/reset2fa/verify-otp',
  '/auth/reset-2fa/resend-otp':     '/reset2fa/resend-otp',
  '/auth/reset-2fa/enable':         '/reset2fa/enable',
};
// path dạng '/auth/login' hoặc '/auth/status?uc=abc' (query giữ nguyên, không tính vào số đoạn).
function apiUrl(path) {
  const i   = path.indexOf('?');
  const p0  = i === -1 ? path : path.slice(0, i);
  const qs  = i === -1 ? ''   : path.slice(i);
  const p   = VIA_GATEWAY ? (F5_DEEP_ALIAS[p0] || p0) : p0;
  return `${API_ORIGIN}${API_CTX}${p}${qs}`;
}

// [API] MỌI lời gọi API phải đi qua hàm này. Lý do: F5 trả HTTP **200 + HTML**
// ("Request Rejected") còn OHS trả 503/404 HTML khi backend chưa lên — cả hai đều
// lọt qua `if (!res.ok)` và làm `res.json()` ném SyntaxError, hiện lên UI thành
// banner "Unexpected token '<'" (bug đã gặp trên app mobile prod). Ở đây kiểm
// content-type trước khi parse và bóc Support ID để đối chiếu ASM log.
async function fetchJson(path, opts) {
  const url = apiUrl(path);
  const res = await fetch(url, opts);
  const ct  = (res.headers.get('content-type') || '').toLowerCase();
  if (ct.indexOf('application/json') === -1) {
    const body = await res.text().catch(function () { return ''; });
    const m    = body.match(/support ID is:\s*([0-9]+)/i) || body.match(/Support ID:\s*([0-9]+)/i);
    const sid  = m ? m[1] : '';
    console.error('[api] phản hồi không phải JSON:', res.status, url,
      sid ? 'SupportID=' + sid : body.slice(0, 200));
    const err = new Error(sid
      ? MESSAGES.API_REJECTED + ' (Support ID ' + sid + ')'
      : MESSAGES.API_UNAVAILABLE);
    err.httpStatus = res.status;
    err.supportId  = sid;
    throw err;
  }
  return res.json();
}

